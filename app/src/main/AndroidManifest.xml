<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ohne diese Zeile wirft jedes vibrate() eine SecurityException, die das
         runCatching in AbcHaptics schluckt: die Haptik ist dann lautlos tot,
         ohne dass irgendetwas darauf hinweist. Normale Berechtigung, sie wird
         beim Installieren erteilt und nichts muss zur Laufzeit gefragt werden. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".AbcApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AbcVorschule">
        <!-- adjustResize, weil das Fenster sonst pant: ohne diese Zeile steht der
             Soft-Input-Modus auf UNSPECIFIED, und dann wählt das System selbst.
             Auf einem Motorola edge 60 pro (Android 16) wählt es Pan und schiebt
             beim Aufklappen der Zahlentastatur (Rechnen ab Ergebnis 11, §8) das
             ganze Fenster nach oben, bis Kopfzeile, Punktestand und
             Fortschrittszeile aus dem Bild wandern. Auf dem Emulator (Android 17)
             fiel das nicht auf — dort blieb das Fenster von sich aus stehen.
             Mit adjustResize kommt die Tastatur nur noch als Inset an, und den
             verbraucht die Übungsfläche in TaskShell selbst. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AbcVorschule">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
